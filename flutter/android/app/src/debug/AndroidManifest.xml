<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.rustadministrator.rustadmin">
    <!-- Flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug builds only: ACTION_BOOT_COMPLETED stand-in for devices
             without root. The release manifest does not declare it. -->
        <receiver android:name=".BootReceiver">
            <intent-filter>
                <action android:name="io.github.rustadministrator.rustadmin.DEBUG_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
