<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps that target it edge to edge, under the status and navigation
         bars. The layout of RustAdmin does not leave room for them yet, so it keeps the
         window inside the bars as before. Same themes as values/styles.xml plus the opt-out. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
